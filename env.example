# Copy to .env. ALL values are intentionally blank: nothing is tested by default.
# Empty/whitespace gate = disabled, regardless of installed packages.
# .env entries (including blanks) override exported variables for run-readers.

# Hosted readers: each API key is that tool's enable/disable gate.
LLAMA_CLOUD_API_KEY=
DATALAB_API_KEY=
REDUCTO_API_KEY=
MISTRAL_API_KEY=
UNSTRUCTURED_API_KEY=
# Optional full legacy Unstructured Partition endpoint (not the Workflows API).
UNSTRUCTURED_API_URL=

# Local readers: set an absolute path to the tool's environment Python.
# A command on PATH such as python3 also works. No heavy libraries are auto-installed.
DOCLING_PYTHON=
MARKER_PYTHON=
UNSTRUCTURED_PYTHON=
PADDLEOCR_PYTHON=
OLMOCR_PYTHON=
PYMUPDF4LLM_PYTHON=
# MinerU's CLI executable, e.g. /path/to/mineru-env/bin/mineru (no shell arguments).
MINERU_COMMAND=

# NuExtract gate: existing OpenAI-compatible server's base URL, ending in /v1.
NUEXTRACT_BASE_URL=
NUEXTRACT_API_KEY=
# Optional Python used for PDF rendering and NuExtract schema conversion.
NUEXTRACT_PYTHON=

# Shared extractor for parser-only tools on the structured-extraction track.
# Both URL and model must be set; the API key is optional for a local server.
# These do not enable any reader by themselves. Native extraction needs neither.
DOCBENCH_EXTRACT_BASE_URL=
DOCBENCH_EXTRACT_MODEL=
DOCBENCH_EXTRACT_API_KEY=

# Existing QA/API model configs only; this does not enable any document reader.
OPENAI_API_KEY=
